# Public trigger and admin server
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=4100

# Internal delivery server. Keep this on loopback.
BRIDGE_INTERNAL_HOST=127.0.0.1
BRIDGE_INTERNAL_PORT=4101

# Absolute workspace root. Every relative_path is resolved under this directory.
WORKSPACE_BASE=/home/you/dev

# Required public bearer token for /trigger and /api/bridge/*.
BRIDGE_TRIGGER_TOKEN=replace-with-a-long-random-token

# Optional internal bearer token. When omitted, the bridge generates one at startup.
# BRIDGE_INTERNAL_TOKEN=replace-with-another-long-random-token

# Persistence and lifecycle
BRIDGE_DB_PATH=~/.night-shift/bridge.db
BRIDGE_TASK_TIMEOUT_MS=900000
BRIDGE_KILL_GRACE_MS=3000
BRIDGE_MAX_CONCURRENCY=1
BRIDGE_MAX_QUEUE_DEPTH=50
BRIDGE_DEDUPE_WINDOW_MS=0
BRIDGE_SHUTDOWN_GRACE_MS=10000
BRIDGE_NOTIFY_ON_SHUTDOWN=true
BRIDGE_RECOVER_NOTIFY=true
BRIDGE_RETENTION_DAYS=30

# Agent
BRIDGE_AGENT_ID=pi
BRIDGE_PI_BINARY=pi
# BRIDGE_PI_MODEL=your-model-id
# BRIDGE_PI_EXTENSION=/absolute/path/to/extensions/delivery.ts
# BRIDGE_SYSTEM_PROMPT=/absolute/path/to/custom-system-prompt.md

# Notifiers: comma-separated list of dingtalk and/or generic
BRIDGE_NOTIFIERS=dingtalk

# DingTalk custom group robot
# Create the robot in a DingTalk group and copy its webhook URL.
# Security settings: pick "Signature" (加签) and copy the secret below, or
# restrict by custom keyword / IP allowlist instead. With the keyword option
# every notification must contain one of the configured keywords.
DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=replace-me
# DINGTALK_WEBHOOK_SECRET=replace-me

# Generic JSON webhook
# GENERIC_WEBHOOK_URL=https://example.com/bridge-result
# GENERIC_WEBHOOK_TOKEN=replace-me
