{
  "name": "night-shift-orchestrator",
  "version": "0.1.0",
  "description": "Strict serial multi-agent CLI orchestrator for unattended overnight vibe coding",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "dev:ui": "vite",
    "build": "vite build",
    "start": "bun src/index.ts",
    "test": "bun test",
    "test:e2e": "bun scripts/e2e-real-agent.ts",
    "test:e2e:opencode": "bun scripts/e2e-real-agent.ts --agent=opencode",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "start:bridge": "bun src/bridge/server.ts",
    "test:bridge": "bun test src/bridge",
    "test:bridge:mock": "bun scripts/bridge-mock.ts"
  },
  "dependencies": {
    "hono": "^4.13.16",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/bun": "latest",
    "@types/node": "^22.13.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
