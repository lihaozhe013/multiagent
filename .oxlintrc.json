{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "deny"
  },
  "rules": {
    "typescript/no-explicit-any": "warn",
    "no-console": "off",
    "unicorn/no-null": "off",
    "no-magic-numbers": "off",
    "sort-imports": "off",
    "capitalized-comments": "off",
    "func-style": "off",
    "no-unused-vars": "warn"
  },
  "ignorePatterns": [
    "node_modules",
    "dist",
    ".cache",
    "coverage",
    "*.min.js"
  ]
}
